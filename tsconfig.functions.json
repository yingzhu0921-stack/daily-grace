{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* src 쪽 tsconfig.app.json 과 같은 느슨함을 쓴다.
       목적은 '존재하지 않는 이름·오타'를 잡는 것이지 엄격화가 아니다. */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false
  },
  "include": ["functions"]
}
